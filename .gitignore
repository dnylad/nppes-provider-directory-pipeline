# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/

# Environment and editor files
.env
.vscode/
.idea/

# Data layers and local source data
# data/raw is the source landing zone. Bronze holds minimally transformed
# Massachusetts subsets; Silver holds conformed cohort tables; Gold holds
# local analytics and aggregate reports.
data/raw/*
!data/raw/.gitkeep
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep
data/gold/reports/*
data/gold/manifests/*

# Local DuckDB databases
*.duckdb
*.db

# Test and coverage artifacts
.coverage
coverage.xml
htmlcov/
